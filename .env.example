DASHBOARD_PASSWORD=change-me
AUTH_SECRET=change-me-too
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_WORKER_KEY=your-worker-or-service-role-key
OFFICE_TV_COMPANY_IDS=ALL
OFFICE_TV_OFFICE_IDS=ALL
DISPLAY_CURRENCY=usd

# Customer health ticker (optional). Customer health lives in the finance app's
# Supabase project (a DIFFERENT project, admin-only). The wallboard does NOT hold
# that project's service-role key — it calls a dedicated read-only edge function
# (customer-health-ticker) with a narrow shared secret that returns only the
# ticker rows. Set the same secret as CUSTOMER_HEALTH_TICKER_SECRET in Supabase.
HEALTH_TICKER_URL=https://your-finance-project.supabase.co/functions/v1/customer-health-ticker
HEALTH_TICKER_SECRET=shared-secret-also-set-in-supabase
# Optional: show synthetic +/- deltas before real history exists (demo only).
# HEALTH_TICKER_PREVIEW=1

# Slack -> Jam QR (optional)
# The TV reads SLACK_JAM_CHANNEL_ID for the newest Spotify Jam link and renders
# it as a QR. The bot token needs the channels:history scope and the bot must be
# invited to the channel. Post "clear jam" in the channel to take the QR down.
SLACK_BOT_TOKEN=
SLACK_JAM_CHANNEL_ID=
JAM_LINK_MAX_AGE_MINUTES=180

# Spotify "Now Playing" widget (optional). Register an app at
# developer.spotify.com/dashboard with redirect URI
# http://127.0.0.1:3000/api/spotify/callback, then visit /api/spotify/auth once
# to obtain the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
